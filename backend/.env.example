# Copy to `.env` (gitignored) and fill in. docker-compose reads this
# automatically. Never commit the real .env — see backend/.gitignore.

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=professional_connections

GCP_PROJECT_ID=local-dev

# From LinkedIn Developer Portal (https://www.linkedin.com/developers/apps) —
# create an app, request the "Sign In with LinkedIn using OpenID Connect"
# product, and set an authorized redirect URL matching LINKEDIN_REDIRECT_URI
# below exactly (LinkedIn checks this for an exact match).
#
# IMPORTANT: LinkedIn requires an absolute https:// redirect URL — it will
# NOT accept a custom URL scheme (professionalconnections://...) directly.
# This must be the deployed auth-bridge/ URL (see auth-bridge/README.md,
# Firebase Hosting recommended), e.g. https://<project-id>.web.app — the
# bridge page is what forwards to the custom scheme; LinkedIn never sees
# the scheme itself. Do not put the custom scheme here.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://<your-project-id>.web.app

# Level 0 federated identity (ADR-014) — account creation via Sign in with
# Apple (iOS) / Google Sign-In (Android), LinkedIn now optional. Neither
# credential below exists yet (Action Tracker §1) — leave both empty for
# local dev/tests; internal/identity's providers still start up and fetch
# their real JWKS, they just reject every token until a real audience is
# configured (fails closed, not open — see identity.Verify's doc comment).
#
# APPLE_SERVICES_ID: from the Apple Developer Portal (developer.apple.com)
# — Certificates, Identifiers & Profiles -> Identifiers -> create a
# Services ID with "Sign in with Apple" enabled. This is the expected
# `aud` claim on Apple's id_token, NOT your app's bundle ID.
APPLE_SERVICES_ID=
# GOOGLE_CLIENT_ID: from Google Cloud Console (console.cloud.google.com)
# — APIs & Services -> Credentials -> OAuth 2.0 Client ID (the Android
# client, per frontend/level0-federated-identity-PLAN.md's v1 scope —
# Google Sign-In ships on Android only for this first cut). This is the
# expected `aud` claim on Google's id_token.
GOOGLE_CLIENT_ID=

# Phone OTP delivery (Level 2/3 verification slice, ADR-012 + its
# 2026-08-17 correction — plain Twilio Programmable Messaging API, NOT
# Twilio Verify). From the Twilio Console (console.twilio.com): Account
# SID and Auth Token are on the dashboard; the phone number is a Twilio
# number provisioned for sending, in E.164 format (e.g. +14155551234).
# Leave empty for local dev/tests — the backend falls back to
# LoggingSmsSender (logs the code instead of sending) when these are unset.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Personal/corporate email OTP delivery, and email+password signup OTP
# (ADR-014 decision #2). Two real-delivery options, checked in this order
# by newEmailSender (cmd/server/main.go):
#
# 1. Gmail SMTP (preferred for testing) — GMAIL_ADDRESS is a real Gmail
#    address, GMAIL_APP_PASSWORD is a Google App Password for it (Google
#    Account -> Security -> 2-Step Verification -> App passwords; NOT the
#    account's normal login password, Gmail's SMTP AUTH rejects that
#    outright once 2-Step Verification is on, which it is by default). A
#    Gmail account can send to ANY recipient immediately — no sandbox
#    restriction — which is what makes it useful for testing signup with
#    arbitrary email addresses.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
#
# 2. Resend (resend.com) — API key from the Resend dashboard.
#    RESEND_FROM_EMAIL needs a domain verified with Resend (Dashboard ->
#    Domains -> DNS records) for production; until then,
#    "onboarding@resend.dev" works WITHOUT domain verification but ONLY
#    sends to the email address your Resend account was signed up with —
#    fine for solo testing against your own inbox, but it will not deliver
#    to any other recipient until a real domain is verified.
#
# Leave all four empty for local dev/tests with neither set up yet;
# backend falls back to LoggingEmailSender the same way SMS does.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Push notifications for meetup request events (ADR-013 § 6,
# backend/meetup-scheduling-PLAN.md). From the Firebase Console: Project
# Settings -> Service Accounts -> Generate new private key — paste the
# entire downloaded JSON file's contents here as a single-line value (or
# leave empty for local dev/tests; the backend falls back to
# LoggingPushSender, which logs the notification payload instead of
# calling FCM, the same fallback pattern as TWILIO_*/RESEND_* above).
FIREBASE_SERVICE_ACCOUNT_JSON=
